  "transcript": [
    {
      "start": 0.0,
      "end": 2.0,
      "text": "buenas tardes, mi nombre es Humberto Damienes,"
    },
    {
      "start": 2.1,
      "end": 5.0,
      "text": "las que me han estengo 17 años y soy de la Ciudad de México."
    },
    {
      "start": 5.6,
      "end": 8.0,
      "text": "Actualmente estoy estudiando el ECCI 4 del Instituto"
    },
    {
      "start": 8.0,
      "end": 11.1,
      "text": "Politecnico Nacional en donde además me estén"
    },
    {
      "start": 11.1,
      "end": 13.3,
      "text": "desempeñando a la carrera de preciosos industriales."
    },
    {
      "start": 13.8,
      "end": 16.7,
      "text": "Mi experiencia laboral ha sido sobre todos los negocios locales"
    },
    {
      "start": 16.7,
      "end": 20.2,
      "text": "donde me he desempeñado durante un año en una tienda de barrotes"
    },
    {
      "start": 20.2,
      "end": 23.9,
      "text": "y tres años más en un restaurante donde yo siempre trataba"
    },
    {
      "start": 23.9,
      "end": 25.4,
      "text": "mis clientes con mi mejor servicio."
    },
    {
      "start": 26.2,
      "end": 29.9,
      "text": "Me considero una persona muy apasionada en todo lo que hago"
    },
    {
      "start": 29.9,
      "end": 33.5,
      "text": "y me gusta mucho trabajar en equipo y pues aportar todo lo que pueda"
    },
    {
      "start": 33.5,
      "end": 35.4,
      "text": "para conseguir los objetivos in común."
    },
    {
      "start": 36.1,
      "end": 38.9,
      "text": "Estoy en busca de una empresa donde pueda seguir desarrollándome"
    },
    {
      "start": 38.9,
      "end": 41.5,
      "text": "y poder practicar todos mis conocimientos adquiridos."
    },
    {
      "start": 42.2,
      "end": 42.7,
      "text": "Muchas gracias."
    },
    {
      "start": 43.3,
      "end": 45.4,
      "text": "buenas tardes, mi nombre es Humberto Damienes,"
    },
    {
      "start": 45.5,
      "end": 47.5,
      "text": "las que me han estengo 17 años y soy de la Ciudad de México."
    }
  ],
